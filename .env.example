# Copy to .env and adjust. .env is git-ignored.

# --- Server ---
PORT=3000
# 0.0.0.0 lets phones/laptops on your LAN connect (multi-client testing).
HOST=0.0.0.0

# --- Postgres (docker compose) ---
POSTGRES_USER=draft
POSTGRES_PASSWORD=draft
POSTGRES_DB=draft
POSTGRES_PORT=5432
DATABASE_URL=postgres://draft:draft@localhost:5432/draft

# --- Better Auth (Phase 3) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Legacy next-auth (removed at end of Phase 3) ---
AUTH_SECRET=
